    "@qmoosa/pqc-hybrid-tls-sdk": "file:packages/qmoosa-pqc-hybrid-tls-sdk-1.0.0.tgz"
  },
  "keywords": [
    "qmoosa",
    "pqc",
    "hybrid-tls",
    "tls-1.3",
    "x25519",
